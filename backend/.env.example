# ── LogiPredict AI – Backend Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values

# ── Database ─────────────────────────────────────────────────────────────────
# Option 1: MySQL (recommended for production)
DATABASE_URL=mysql+pymysql://root:Anuj%401505@localhost:3306/logipredict

# Option 2: SQLite (zero-config, for local dev)
# Set USE_SQLITE=true to skip MySQL entirely
USE_SQLITE=false

# ── Gemini AI API Key ─────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Leave empty to use rule-based chatbot fallback
GEMINI_API_KEY=

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Change this in production!
JWT_SECRET=logipredict-secret-key-change-in-production
